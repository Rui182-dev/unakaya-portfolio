---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ReelSection from '../components/sections/ReelSection.astro';
import WorkGridSection from '../components/sections/WorkGridSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import { site } from '../data/site';

const reelStructuredData = site.reelEmbedUrl && Astro.site ? {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'Urui Nakaya – FX Artist Demo Reel 2026',
	description: site.reelSummary,
	thumbnailUrl: new URL(site.reelPoster, Astro.site).href,
	uploadDate: site.reelUploadDate,
	duration: site.reelDuration,
	embedUrl: site.reelCleanEmbedUrl,
} : undefined;

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const personalWorks = works.filter((work) => work.data.category === 'personal');
const commercialWorks = works.filter((work) => ['commercial', 'team'].includes(work.data.category));
const toolWorks = works.filter((work) => ['tool', 'rnd'].includes(work.data.category));
---

<MainLayout>
	{reelStructuredData && <script type="application/ld+json" set:html={JSON.stringify(reelStructuredData)} />}
	<HeroSection />
	<ReelSection />
	<WorkGridSection
		id="selected-work"
		eyebrow="Selected Personal Work"
		title="Selected FX Shots"
		copy="Houdini-based simulation work including RBD, FLIP, and Pyro."
		works={personalWorks}
		variant="featured"
	/>
	<WorkGridSection
		id="commercial-work"
		eyebrow="Commercial Work / Team Project"
		title="Production and Team Projects"
		copy="Selected production contributions, team projects, and HDA-driven workflows."
		works={commercialWorks}
		variant="compact"
	/>
	<WorkGridSection
		id="tool-work"
		eyebrow="Tool / R&D"
		title="Tool Development and R&D"
		copy="Procedural tools and technical experiments supporting FX workflows."
		works={toolWorks}
		variant="compact"
	/>
	<AboutSection />
</MainLayout>
